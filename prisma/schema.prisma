generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

// The connection URL lives in prisma.config.ts; the app connects through @prisma/adapter-pg.
datasource db {
  provider = "postgresql"
}

// Shopify sessions, read and written by src/lib/session-storage.server.ts
model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?

  @@index([shop])
}

// Entrolytics configuration per shop
model EntrolyticsConfig {
  id           String   @id @default(cuid())
  shop         String   @unique
  websiteId    String
  clientKey    String
  host         String   @default("https://entrolytics.click")
  autoTrack    Boolean  @default(true)
  trackRevenue Boolean  @default(true)
  respectDnt   Boolean  @default(false)
  scriptTagId  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([shop])
}
