# Shopify App Configuration
SHOPIFY_API_KEY=your_api_key
SHOPIFY_API_SECRET=your_api_secret
SHOPIFY_APP_URL=https://your-app-url.com
SCOPES=read_themes,write_themes,read_script_tags,write_script_tags,read_orders,read_products

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/entrolytics_shopify

# Entrolytics Backend (optional - for verification)
ENTROLYTICS_API_URL=https://api.entrolytics.click
ENTROLYTICS_API_KEY=your_api_key
