{
  "name": "@entrolytics/shopify-app",
  "version": "3.0.1",
  "private": true,
  "description": "Shopify app for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "ecommerce",
    "entrolytics",
    "shopify",
    "shopify-app"
  ],
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.click>",
  "type": "module",
  "scripts": {
    "dev": "shopify app dev",
    "build": "remix vite:build",
    "check": "tsc --noEmit",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "deploy": "shopify app deploy",
    "generate": "shopify app generate"
  },
  "dependencies": {
    "@prisma/client": "^7.10.0",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@shopify/app-bridge-react": "^4.2.13",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-remix": "^5.0.1",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.1",
    "isbot": "^5.2.2",
    "react": "canary",
    "react-dom": "canary",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@shopify/cli": "^4.7.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "prisma": "^8.0.0-rc.13",
    "typescript": "next",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.26.0"
}
