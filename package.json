{
  "name": "@entrolytics/shopify-app",
  "version": "2.2.1",
  "private": true,
  "description": "Shopify app for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "ecommerce",
    "entrolytics",
    "shopify",
    "shopify-app"
  ],
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.click>",
  "type": "module",
  "scripts": {
    "dev": "shopify app dev",
    "build": "remix vite:build",
    "check": "vp check",
    "lint": "vp lint --fix . && vp fmt --write .",
    "lint:check": "vp lint . && vp fmt --check .",
    "lint:fix-unsafe": "vp lint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "vp fmt --write .",
    "test": "vp test run",
    "typecheck": "tsc --noEmit",
    "deploy": "shopify app deploy",
    "generate": "shopify app generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "@remix-run/node": "^2.17.5",
    "@remix-run/react": "^2.17.5",
    "@shopify/app-bridge-react": "^4.2.12",
    "@shopify/polaris": "^13.9.5",
    "@shopify/shopify-app-remix": "^5.0.0",
    "@shopify/shopify-app-session-storage-prisma": "^10.0.0",
    "isbot": "^5.2.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.17.5",
    "@shopify/cli": "^4.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "prisma": "^6.19.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vite-plus": "^0.2.8"
  },
  "engines": {
    "node": ">=24.19.0"
  },
  "packageManager": "pnpm@11.21.0"
}
