{
  "name": "@entrolytics/shopify-app",
  "version": "3.0.1",
  "private": true,
  "description": "Shopify app for Entrolytics - First-party growth analytics for the edge",
  "keywords": [
    "analytics",
    "ecommerce",
    "entrolytics",
    "shopify",
    "shopify-app"
  ],
  "license": "MIT",
  "author": "Entrolytics <hey@entrolytics.dev>",
  "type": "module",
  "scripts": {
    "dev": "shopify app dev",
    "postinstall": "prisma generate",
    "build": "react-router build",
    "check": "react-router typegen && tsc --noEmit",
    "lint": "oxlint --fix . && oxfmt --write .",
    "lint:check": "oxlint . && oxfmt --check .",
    "lint:fix-unsafe": "oxlint -f stylish --import-plugin --type-aware --type-check --vitest-plugin --fix --fix-suggestions --fix-dangerously src/",
    "format": "oxfmt --write .",
    "test": "vitest run",
    "typecheck": "react-router typegen && tsc --noEmit",
    "deploy": "shopify app deploy",
    "generate": "shopify app generate"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@react-router/fs-routes": "^8.5.1",
    "@react-router/node": "^8.5.1",
    "@shopify/app-bridge-react": "^4.2.14",
    "@shopify/shopify-app-react-router": "^4.0.0",
    "@shopify/shopify-app-session-storage": "^7.0.1",
    "isbot": "^5.2.2",
    "react": "latest",
    "react-dom": "latest",
    "react-router": "^8.5.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@shopify/cli": "^5.0.0",
    "@shopify/polaris-types": "^2.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "prisma": "^7.10.1",
    "typescript": "next",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "engines": {
    "node": ">=24.22.2"
  },
  "packageManager": "pnpm@12.17.0"
}
